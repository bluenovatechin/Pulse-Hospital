# Server settings. For local testing copy this file to server/.env (never commit it).
# On Render, add the same names under the service's "Environment" tab.

# ---- Security ----
# Password reception staff type to open the Staff portal. Use a long random value:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_KEY=change-me

# Website address(es) allowed to call this API, comma-separated.
# For GitHub Pages use: https://bluenovatechin.github.io
CORS_ORIGIN=https://bluenovatechin.github.io

NODE_ENV=production
# PORT is set automatically by most hosts; defaults to 5000.

# ---- WhatsApp alert when someone books ----
# Provider: meta (official WhatsApp Cloud API, recommended) or callmebot.
WHATSAPP_PROVIDER=meta

# Meta WhatsApp Cloud API
META_WA_TOKEN=EAAG...
META_WA_PHONE_NUMBER_ID=1234567890
# Numbers that receive the alert (country code, no +), comma-separated
WHATSAPP_NOTIFY_TO=916353344875

# CallMeBot alternative (third-party service; only if WHATSAPP_PROVIDER=callmebot)
# CALLMEBOT_RECIPIENTS=916353344875:APIKEY
# Approved template with 5 body variables: {{1}} token ID, {{2}} patient,
# {{3}} phone, {{4}} doctor, {{5}} date & slot. Leave unset to send plain text
# (plain text is only delivered within 24h of the recipient messaging your business number).
META_WA_TEMPLATE=new_appointment
META_WA_TEMPLATE_LANG=en
